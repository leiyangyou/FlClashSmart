{
  "port": 17891,
  "socks-port": 17892,
  "redir-port": 17893,
  "tproxy-port": 17894,
  "mixed-port": 17890,
  "ss-config": "",
  "vmess-config": "",
  "inbound-tfo": false,
  "inbound-mptcp": false,
  "authentication": [
    "profile:secret"
  ],
  "skip-auth-prefixes": [
    "127.0.0.1/32"
  ],
  "lan-allowed-ips": [
    "0.0.0.0/0",
    "::/0"
  ],
  "lan-disallowed-ips": null,
  "allow-lan": true,
  "bind-address": "*",
  "mode": "global",
  "unified-delay": false,
  "log-level": "debug",
  "ipv6": true,
  "external-controller": "127.0.0.1:19090",
  "external-controller-routing-mark": 0,
  "external-controller-pipe": "",
  "external-controller-unix": "",
  "external-controller-tls": "",
  "external-controller-cors": {
    "allow-origins": [
      "*"
    ],
    "allow-private-network": true
  },
  "external-ui": "ui",
  "external-ui-url": "https://profile.example/ui.zip",
  "external-ui-name": "",
  "external-doh-server": "",
  "secret": "",
  "interface-name": "en9",
  "routing-mark": 0,
  "tunnels": null,
  "geo-auto-update": true,
  "geo-update-interval": 6,
  "geodata-mode": false,
